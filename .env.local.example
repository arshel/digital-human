# Kopieer naar .env.local en vul je eigen sleutels in. .env.local staat in .gitignore.

# Gemini (aistudio.google.com → Get API key). Alleen server-side (lib/gemini.ts).
GEMINI_API_KEY=replace_with_new_key

# Standaard: gemini-3.1-flash-lite voorop, daarna gemini-3.6-flash, gemini-3.8-flash en
# gemini-3.5-flash als het eerste op (429) of overbelast (503) is. Een eigen volgorde zet
# je hier, komma-gescheiden. Voor een gebruikerstest kun je het op één model vastzetten:
# GEMINI_MODELS=gemini-3.1-flash-lite

# LiveAvatar (HeyGen). Alleen server-side (app/api/liveavatar/token/route.ts).
# Nooit in de client, nooit als NEXT_PUBLIC_.
LIVEAVATAR_API_KEY=replace_with_new_key
