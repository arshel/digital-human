# Kopieer naar .env.local en vul de waarden in. .env.local staat in .gitignore.
# Alles hieronder wordt alleen op de server gelezen. Nooit een sleutel als NEXT_PUBLIC_.

# ---------- Modi ----------

# simulated (standaard): ontwikkelmodus. D-ID wordt niet aangeroepen; de avatar is gesimuleerd,
#   de tekst staat in beeld en de browserstem leest voor als die Nederlands kan.
# did: echte D-ID-stream, pas na "Start". Kost streamingtegoed.
AVATAR_MODE=simulated

# test (standaard): de vaste testselectie uit data/test-articles.json.
# live: de actuele NOS-feed.
NEWS_MODE=test

# ---------- Gemini (tekst) ----------

# aistudio.google.com → Get API key.
GEMINI_API_KEY=

# Optioneel: modellen in volgorde van voorkeur, komma-gescheiden. Zet voor een gebruikerstest op
# één model, zodat elke deelnemer dezelfde Nova krijgt:
# GEMINI_MODELS=gemini-3.1-flash-lite

# ---------- Groq en Mistral (tekst, optioneel, sneller dan Gemini) ----------

# Volgorde: Groq, Mistral, Gemini; alleen aanbieders met een sleutel doen mee. Faalt de eerste of
# is die te traag, dan de volgende. Andere volgorde: AI_PROVIDERS=mistral,groq,gemini

# console.groq.com → API Keys. Gratis tier zonder creditcard.
GROQ_API_KEY=
# Optioneel, in volgorde van voorkeur (Groq vervangt modellen geregeld):
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# console.mistral.ai → API Keys. Let op: de gratis tier (Experiment) mag de invoer gebruiken om
# modellen te trainen, ook vragen van deelnemers. Voor een echte gebruikerstest: betaald plan.
MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-small-latest

# Optioneel: lengte van de basisuitleg in woorden (startpunt, geen harde grens). Standaard 60-90.
# NOVA_CORE_WORDS=60-90

# ---------- D-ID (beeld en stem) ----------

# API-sleutel uit D-ID Studio (Account → API key). Alleen voor de server en scripts/did-setup.mjs.
DID_API_KEY=

# Gemaakt door: node --env-file=.env.local scripts/did-setup.mjs create
# De client key is de beperkte sleutel die D-ID voor de browser bedoelt; die werkt alleen vanaf de
# domeinen die bij de agent zijn toegestaan (D-ID Studio → Agents → … → Embed).
DID_AGENT_ID=
DID_CLIENT_KEY=
# Stilstaand beeld en stil, bewegend beeld (idle-video) van de presentator vóór de start. Gewone
# bestanden van D-ID: geen stream en geen kosten. Staan bij de agent (GET /agents/{id}).
DID_POSTER_URL=
DID_IDLE_VIDEO_URL=

# Optioneel. Presentator voor `did-setup.mjs create` (standaard een Clips-presentator van D-ID).
# DID_PRESENTER_ID=v2_public_Mary_NoHands_PurpleShirt_Office@vA__Ta4xnN

# Optioneel. Stem en tempo per speak(). Andere Nederlandse stemmen: nl-NL-ColetteNeural,
# nl-NL-MaartenNeural (lijst: GET https://api.d-id.com/tts/voices?provider=microsoft).
# DID_VOICE_ID=nl-NL-FennaNeural
# DID_VOICE_RATE=1

# Optioneel. Korte SSML-pauze na elke zin (standaard uit). Bij onze Talks-agent las D-ID de
# <break>-code hardop voor. Alleen aanzetten om opnieuw te testen.
# DID_SENTENCE_BREAKS=0

# Optioneel. Begrenzing over het hele prototype, in seconden (standaard 1200 = 20 minuten).
# Telt de grootste van: gesproken videotijd (gemeld door D-ID) en verbindingstijd (schatting).
# DID_BUDGET_SECONDS=1200

# Optioneel. "Nog een keer" uit een opname in het geheugen van de browser (standaard aan).
# Op 0 vraagt herhalen een nieuwe video aan D-ID.
# DID_LOCAL_REPLAY=1

# ---------- Testlog ----------

# Standaard aan: logs/answers.jsonl (bericht, artikelversie, promptversie, knop, model; geen
# vraag- of antwoordtekst) en logs/did-usage.jsonl. Uitzetten met 0.
# NOVA_TEST_LOG=1
