# Kopieer naar .env.local en vul de waarden in. .env.local staat in .gitignore.
# Alles hieronder wordt alleen op de server gelezen. Nooit een sleutel als NEXT_PUBLIC_.

# ---------- Modi ----------

# simulated (standaard): ontwikkelmodus. Anam wordt niet aangeroepen; de avatar is gesimuleerd,
#   de tekst staat in beeld en de browserstem leest voor als die Nederlands kan.
# anam: echte Anam-stream, pas na "Start". Kost Anam-minuten.
AVATAR_MODE=simulated

# test (standaard): de vaste testselectie uit data/test-articles.json.
# live: Nederlands nieuws van vandaag van de NOS (feeds Binnenland en Politiek).
# Optioneel andere NOS-feeds, komma-gescheiden (zie lib/feeds.ts):
# NEWS_FEEDS=nosnieuwsbinnenland,nosnieuwspolitiek
NEWS_MODE=test

# ---------- Gemini (tekst) ----------

# aistudio.google.com → Get API key.
GEMINI_API_KEY=

# Optioneel: modellen in volgorde van voorkeur, komma-gescheiden. Zet voor een gebruikerstest op
# één model, zodat elke deelnemer dezelfde Nova krijgt:
# GEMINI_MODELS=gemini-3.1-flash-lite

# ---------- Groq en Mistral (tekst, optioneel, sneller dan Gemini) ----------

# Volgorde: Groq, Mistral, Gemini; alleen aanbieders met een sleutel doen mee. Faalt de eerste of
# is die te traag, dan de volgende. Andere volgorde: AI_PROVIDERS=mistral,groq,gemini

# console.groq.com → API Keys. Gratis tier zonder creditcard.
GROQ_API_KEY=
# Optioneel, in volgorde van voorkeur (Groq vervangt modellen geregeld):
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# console.mistral.ai → API Keys. Let op: de gratis tier (Experiment) mag de invoer gebruiken om
# modellen te trainen, ook vragen van deelnemers. Voor een echte gebruikerstest: betaald plan.
MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-small-latest

# Optioneel: lengte van de basisuitleg in woorden (startpunt, geen harde grens). Standaard 60-90.
# NOVA_CORE_WORDS=60-90

# ---------- Anam (beeld en stem) ----------

# lab.anam.ai → API keys. Alleen voor de server; de browser krijgt een kortlevend token.
ANAM_API_KEY=
# De avatar (gemaakt van de foto, POST /v1/avatars) en de Nederlandse stem ("Peter").
ANAM_AVATAR_ID=
ANAM_VOICE_ID=
# Optioneel: beeld en wachtvideo vóór Start (standaard /anam/nova.webp en /anam/nova-idle.mp4).
# ANAM_POSTER_URL=
# ANAM_IDLE_VIDEO_URL=

# ---------- Testlog ----------

# Standaard aan: logs/answers.jsonl (bericht, artikelversie, promptversie, knop, model; geen
# vraag- of antwoordtekst). Uitzetten met 0.
# NOVA_TEST_LOG=1
